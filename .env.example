# Server-side API origin used by App Router rendering and sitemap generation.
# It may be an internal address, but it is never bundled into browser code.
API_URL=http://127.0.0.1:4000

# Public API origin used by browser-side search, filters, cart and checkout.
# In production this must be an HTTPS URL reachable by visitors.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Canonical public website origin. Keep this exact production value in production.
NEXT_PUBLIC_SITE_URL=https://skinbyyas.com
