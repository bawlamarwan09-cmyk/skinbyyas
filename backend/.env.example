# Runtime
NODE_ENV=development
PORT=4000

# PostgreSQL connection. Replace all placeholder credentials locally/privately.
DATABASE_URL=postgresql://skin_by_yas_user:replace-me@localhost:5432/skin_by_yas

# Exact frontend origin allowed by CORS. Production: https://skinbyyas.com
FRONTEND_URL=http://localhost:3000

# Generate a unique random value of at least 32 characters. Never commit the real value.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h

# Configure only when the business has confirmed its delivery rule.
SHIPPING_COST_MAD=0
